<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

<LinearLayout
    android:id="@+id/dialogCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog"
    android:clickable="true"
    android:padding="24dp">

    <!-- Header: Bolla del Voto + Titolo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/dialogTxtVotoBolla"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:text="8½"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="#30D158"
            android:background="@drawable/bg_voto_bolla"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/dialogTxtMateria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MATEMATICA"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/dialogTxtTipoValutazione"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Valutazione"
                android:textColor="#8E8E93"
                android:textSize="13sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2C2C2E"
        android:layout_marginBottom="16dp"/>

    <!-- Data e Peso -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅 Data: "
                android:textColor="#8E8E93"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/dialogTxtData"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12/10"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚖️ Peso: "
                android:textColor="#8E8E93"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/dialogTxtPeso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100%"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Note del Docente -->
    <LinearLayout
        android:id="@+id/dialogLayoutNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_note"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💬 Note del Docente:"
            android:textColor="#007AFF"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/dialogTxtNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/dialogBtnChiudi"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Chiudi"
        android:textColor="#FFFFFF"
        android:backgroundTint="#2C2C2E"
        app:cornerRadius="12dp"
        android:layout_marginTop="20dp"/>
</LinearLayout>
</FrameLayout>
